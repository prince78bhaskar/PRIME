# P.R.I.M.E. Backend Environment Configuration
#
# Copy this file to `.env` and adjust values for your environment.
# All variables are prefixed with PRIME_ to avoid collisions.
#
# IMPORTANT: Never commit the actual .env file to version control.
#            Only this .env.example template should be tracked.

# ── Application ──────────────────────────────────────────────────
PRIME_APP_NAME="P.R.I.M.E."
PRIME_APP_VERSION="0.2.0-alpha.phase01"
PRIME_ENVIRONMENT="development"
PRIME_DEBUG=false

# ── Server ───────────────────────────────────────────────────────
PRIME_HOST="127.0.0.1"
PRIME_PORT=8000

# ── Logging ──────────────────────────────────────────────────────
PRIME_LOG_LEVEL="INFO"
PRIME_LOG_FORMAT="json"

# ── Database ─────────────────────────────────────────────────────
# PRIME_DB_PATH="./data/memory/prime.db"

# ── Ollama (Phase 01+) ──────────────────────────────────────────
PRIME_OLLAMA_BASE_URL="http://127.0.0.1:11434"
PRIME_OLLAMA_MODEL="qwen2.5:3b-instruct-q4_K_M"
PRIME_OLLAMA_TIMEOUT_SECONDS=30

# ── Offline voice pipeline (Phase 04) ───────────────────────────
# Download these files locally before using voice. See docs/phases/PHASE_04.md.
PRIME_VOICE_STT_MODEL_PATH="../models/faster-whisper-small"
PRIME_VOICE_STT_DEVICE="cpu"
PRIME_VOICE_STT_COMPUTE_TYPE="int8"
PRIME_VOICE_TTS_EN_MODEL_PATH="../models/voice/en_US-lessac-medium.onnx"
PRIME_VOICE_TTS_HI_MODEL_PATH="../models/voice/hi_IN-pratham-medium.onnx"
PRIME_VOICE_MAX_AUDIO_BYTES=26214400
PRIME_VOICE_MAX_TEXT_CHARS=5000
